<Window x:Class="BetterAccounting.UI.Views.AccountEditorView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="360" Width="460"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="0,2,0,10" Padding="4"/>

            <TextBlock Text="Group"/>
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group, Mode=TwoWay}" Margin="0,2,0,10"/>

            <TextBlock Text="Description"/>
            <TextBox Text="{Binding Description, Mode=TwoWay}" Margin="0,2,0,10" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Opening Balance"/>
                    <TextBox Text="{Binding OpeningBalance, Mode=TwoWay}" Margin="0,4,0,0" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Balance Type"/>
                    <ComboBox ItemsSource="{Binding BalanceTypes}" SelectedItem="{Binding OpeningBalanceType, Mode=TwoWay}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,4" Margin="5,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,4" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
