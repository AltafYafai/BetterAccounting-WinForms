<Window x:Class="BetterAccounting.UI.Views.ChartOfAccountsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chart of Accounts" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Add" Click="AddAccount_Click" Padding="5,2"/>
            <Button Content="Edit" Click="EditAccount_Click" Padding="5,2" Margin="5,0"/>
            <Button Content="Delete" Click="DeleteAccount_Click" Padding="5,2" Margin="5,0"/>
        </ToolBar>

        <!-- Accounts DataGrid -->
        <DataGrid x:Name="AccountsGrid" Grid.Row="1" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120"/>
                <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, StringFormat=C}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
