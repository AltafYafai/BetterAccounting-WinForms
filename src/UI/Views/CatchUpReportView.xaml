<Window x:Class="BetterAccounting.UI.Views.CatchUpReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catch-Up Payments" Height="560" Width="820">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="From:" VerticalAlignment="Center"/>
            <DatePicker Width="120" SelectedDate="{Binding FromDate}" Margin="5,0,5,0" VerticalAlignment="Center"/>
            <Label Content="To:" VerticalAlignment="Center"/>
            <DatePicker Width="120" SelectedDate="{Binding ToDate}" Margin="5,0,5,0" VerticalAlignment="Center"/>
            <Button Content="Generate" Command="{Binding GenerateCommand}" Padding="10,2" Margin="5,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="*"/>
                <DataGridTextColumn Header="Opening" Binding="{Binding OpeningBalance, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Invoiced" Binding="{Binding Invoiced, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Closing" Binding="{Binding ClosingBalance, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Over Paid" Binding="{Binding OverPayment, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>