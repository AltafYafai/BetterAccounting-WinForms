<Window x:Class="BetterAccounting.UI.Views.CompanyManagerView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        Title="Companies (Client Manager)" Width="560" Height="560"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.4*"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Text="Removed (kept safe — restore to recover)" Foreground="Gray" Margin="0,0,0,4"/>

            <ListBox Grid.Row="2" ItemsSource="{Binding RemovedItems}" SelectedItem="{Binding SelectedRemoved}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Add a new company / client"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Add &amp; Switch" Command="{Binding AddCompanyCommand}"
                        Padding="10,4" Width="110"/>
                <TextBox Text="{Binding NewCompanyName}"
                         Padding="4" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Rename the selected company"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding RenameCommand}"
                        Padding="10,4" Width="80"/>
                <TextBox Text="{Binding RenameName}"
                         Padding="4" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" Padding="10,4" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Remove (keeps backup)" Click="Remove_Click" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="Activate" Command="{Binding ActivateCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Content="Restore removed" Command="{Binding RestoreCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>
    </Grid>
</Window>
