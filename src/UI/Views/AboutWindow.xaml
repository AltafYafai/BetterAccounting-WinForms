<Window x:Class="BetterAccounting.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BetterAccounting" Height="380" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Open Releases" Command="{Binding OpenReleasesCommand}" Padding="10,4" Margin="5,0"/>
            <Button Content="Apply &amp; Restart" Command="{Binding ApplyUpdateCommand}" Padding="10,4" Margin="5,0"/>
            <Button Content="Show Downloaded File" Command="{Binding ShowDownloadedFileCommand}" Padding="10,4" Margin="5,0"/>
            <Button Content="Download Update" Command="{Binding DownloadCommand}" Padding="10,4" Margin="5,0"/>
            <Button Content="Close" Command="{Binding CloseCommand}" Padding="10,4" Margin="5,0" IsDefault="True"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="64" Height="64" Background="#2563EB" CornerRadius="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="BA" FontSize="26" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Version}" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Tagline}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Author}" Margin="0,0,0,4"/>
            <TextBlock>
                <Hyperlink Command="{Binding OpenReleasesCommand}">
                    <Run Text="{Binding RepositoryUrl, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>

            <Separator Margin="0,12"/>

            <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Padding="10,4"
                    HorizontalAlignment="Left" Width="160"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>