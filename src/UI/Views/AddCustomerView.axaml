<Window x:Class="BetterAccounting.UI.Views.AddCustomerView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        Title="Add Customer" Height="580" Width="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Customer" Command="{Binding SaveCommand}" Width="120" Height="30"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="GSTIN:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding Gstin}" Width="220" VerticalAlignment="Center" MaxLength="15"/>
            <Button Content="Fetch from GST Portal" Command="{Binding FetchCommand}" Padding="10,2" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Margin="5,3" VerticalAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Address:" VerticalAlignment="Top" Margin="0,5,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Address}" TextWrapping="Wrap" AcceptsReturn="True" Height="70" Margin="5,3" VerticalScrollBarVisibility="Auto"/>

                <Label Grid.Row="2" Grid.Column="0" Content="City:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding City}" Margin="5,3" VerticalAlignment="Center"/>

                <Label Grid.Row="3" Grid.Column="0" Content="State:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding State}" Margin="5,3" VerticalAlignment="Center"/>

                <Label Grid.Row="4" Grid.Column="0" Content="PIN Code:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PinCode}" Margin="5,3" VerticalAlignment="Center"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Phone:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Phone}" Margin="5,3" VerticalAlignment="Center"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Email}" Margin="5,3" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
