<Window x:Class="BetterAccounting.UI.Views.VoucherEntryView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        Title="Voucher Entry" Width="720" Height="520"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Date:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Date}" VerticalAlignment="Center" Width="180"/>

        <Label Grid.Row="0" Grid.Column="2" Content="Voucher No:" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding VoucherNumber}" VerticalAlignment="Center" Margin="5,0"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Voucher Type:" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding VoucherTypes}"
                  SelectedItem="{Binding SelectedVoucherType}" Width="180" Margin="5,10,0,0" Height="25"/>

        <Label Grid.Row="1" Grid.Column="2" Content="Transporter:" VerticalAlignment="Center" Margin="10,10,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Transporter}" VerticalAlignment="Center" Margin="5,10,0,0" Height="25"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Account:" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  IsEditable="True" Margin="5,10,0,0" Height="25"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Type:" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding EntryTypes}"
                  SelectedItem="{Binding EntryType}" Width="150" Margin="5,10,0,0" Height="25"/>

        <Label Grid.Row="3" Grid.Column="2" Content="Amount:" VerticalAlignment="Center" Margin="10,10,0,0"/>
        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Amount}" VerticalAlignment="Center" Margin="5,10,0,0" Height="25"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Narration:" VerticalAlignment="Top" Margin="0,10,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="{Binding Narration}" AcceptsReturn="True" Height="60" Margin="5,10,0,0"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="{Binding ErrorMessage}" Foreground="OrangeRed" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Print Preview" Command="{Binding OpenPrintPreviewCommand}" Padding="10,5" Margin="5,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" Margin="5,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="10,5" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
