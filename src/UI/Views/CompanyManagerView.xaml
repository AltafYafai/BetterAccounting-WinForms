<Window x:Class="BetterAccounting.UI.Views.CompanyManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companies (Client Manager)" Height="560" Width="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Top" Text="Your companies (clients). Each one keeps its own books and prints its own invoices."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Add a new company / client"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Add &amp; Switch" Command="{Binding AddCompanyCommand}"
                        Padding="10,4" Width="110"/>
                <TextBox Text="{Binding NewCompanyName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Rename the selected company"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Rename" Command="{Binding RenameCommand}"
                        Padding="10,4" Width="80"/>
                <TextBox Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4" Margin="0,0,8,0"/>
            </DockPanel>
        </StackPanel>

        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" Padding="10,4" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Remove (keeps backup)" Click="Remove_Click" Padding="10,4"/>
            <Button DockPanel.Dock="Right" Content="Activate" Command="{Binding ActivateCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="Gray"/>
        </DockPanel>
    </Grid>
</Window>