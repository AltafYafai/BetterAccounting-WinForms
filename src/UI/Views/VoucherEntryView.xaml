<Window x:Class="BetterAccounting.UI.Views.VoucherEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voucher Entry" Height="500" Width="700">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Date -->
        <Label Grid.Row="0" Grid.Column="0" Content="Date:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Date}" VerticalAlignment="Center" Width="180"/>

        <!-- Voucher Number -->
        <Label Grid.Row="0" Grid.Column="2" Content="Voucher No:" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding VoucherNumber}" VerticalAlignment="Center" Margin="5,0"/>

        <!-- Account Selection -->
        <Label Grid.Row="1" Grid.Column="0" Content="Account:" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Accounts}" 
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" 
                  DisplayMemberPath="Name" 
                  IsEditable="True" Margin="5,10,0,0" Height="25"/>

        <!-- Entry Type -->
        <Label Grid.Row="2" Grid.Column="0" Content="Type:" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding EntryTypes}"
                  SelectedItem="{Binding EntryType}" Width="150" Margin="5,10,0,0" Height="25"/>

        <!-- Amount -->
        <Label Grid.Row="2" Grid.Column="2" Content="Amount:" VerticalAlignment="Center" Margin="10,10,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Amount}" VerticalAlignment="Center" Margin="5,10,0,0" Height="25"/>

        <!-- Narration -->
        <Label Grid.Row="3" Grid.Column="0" Content="Narration:" VerticalAlignment="Top" Margin="0,10,0,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" 
                 Text="{Binding Narration}" AcceptsReturn="True" Height="60" Margin="5,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" Margin="5,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="10,5" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
