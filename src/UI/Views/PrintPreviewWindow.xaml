<Window x:Class="BetterAccounting.UI.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview" Height="700" Width="800">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Label Content="Copies:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding CopyOptions}" SelectedItem="{Binding SelectedCopy}" Width="100" VerticalAlignment="Center"/>
                <Button Content="Print" Command="{Binding PrintCommand}" Padding="10,2" Margin="10,0,0,0"/>
            </ToolBar>
        </ToolBarTray>
        <FlowDocumentReader x:Name="FlowReader" Document="{Binding Document}"/>
        <DocumentViewer x:Name="FixedViewer" Visibility="Collapsed"/>
    </DockPanel>
</Window>
