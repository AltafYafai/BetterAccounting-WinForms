<Window x:Class="BetterAccounting.UI.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterAccounting Error" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Width="600" MaxHeight="640" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="OperationText" FontWeight="Bold" FontSize="15" Foreground="#C00000" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Details">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" Height="240"
                     Background="#1E1E1E" Foreground="#DCDCDC" BorderThickness="0"/>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy Error" Click="Copy_Click" Padding="12,4" MinWidth="100" ToolTip="Copy the full error details to the clipboard"/>
            <Button Content="Send Error Report" Click="Send_Click" Padding="12,4" MinWidth="150" Margin="8,0,0,0"
                    ToolTip="Opens your email app with the error report ready to send"/>
            <Button Content="Close" Click="Close_Click" Padding="12,4" MinWidth="80" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
